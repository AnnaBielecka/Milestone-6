    "from faker import Faker\n",
    "\n",
    "# Ініціалізація Faker для генерації випадкових даних\n",
    "fake = Faker()\n",
    "\n",
    "# Клас для книги\n",
    "class Book:\n",
    "    def __init__(self, title, category):\n",
    "        self.title = title\n",
    "        self.category = category\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"Book: {self.title}, Category: {self.category}\"\n",
    "\n",
    "# Клас для полиці\n",
    "class Shelf:\n",
    "    def __init__(self):\n",
    "        # Словник для зберігання книг за категоріями\n",
    "        self.categories = {}\n",
    "\n",
    "    def add_book(self, book):\n",
    "        \"\"\"Додає книгу до відповідної категорії на полиці\"\"\"\n",
    "        if book.category not in self.categories:\n",
    "            self.categories[book.category] = []\n",
    "        self.categories[book.category].append(book)\n",
    "\n",
    "    def sort_books(self):\n",
    "        \"\"\"Сортує книги в кожній категорії за їх заголовками\"\"\"\n",
    "        for category in self.categories.values():\n",
    "            category.sort(key=lambda book: book.title)\n",
    "\n",
    "    def __str__(self):\n",
    "        \"\"\"Повертає текстове представлення полиці, показуючи категорії і книги\"\"\"\n",
    "        result = \"Shelf contains the following books:\\n\"\n",
    "        for category, books in self.categories.items():\n",
    "            result += f\"Category: {category}\\n\"\n",
    "            for book in books:\n",
    "                result += f\"  {book}\\n\"\n",
    "        return result\n",
    "\n",
    "# Клас для кімнати\n",
    "class Room:\n",
    "    def __init__(self):\n",
    "        self.shelves = []\n",
    "\n",
    "    def add_shelf(self, shelf):\n",
    "        \"\"\"Додає полицю до кімнати\"\"\"\n",
    "        self.shelves.append(shelf)\n",
    "\n",
    "    def __str__(self):\n",
    "        \"\"\"Повертає текстове представлення кімнати і її полиць\"\"\"\n",
    "        result = \"Room contains the following shelves:\\n\"\n",
    "        for shelf in self.shelves:\n",
    "            result += str(shelf) + \"\\n\"\n",
    "        return result\n",
    "\n",
    "# Функція для генерації набору книг\n",
    "def generate_books(num_books):\n",
    "    books = set()\n",
    "    categories = [\"Fiction\", \"Science\", \"History\", \"Biography\", \"Fantasy\"]\n",
    "    for _ in range(num_books):\n",
    "        title = fake.sentence(nb_words=3)  # Генеруємо випадкову назву книги\n",
    "        category = fake.random.choice(categories)  # Випадково вибираємо категорію\n",
    "        book = Book(title, category)\n",
    "        books.add(book)  # Додаємо книгу до множини\n",
    "    return books\n",
    "\n",
    "# Створюємо кімнату\n",
    "room = Room()\n",
    "\n",
    "# Генеруємо набір книг\n",
    "books = generate_books(15)\n",
    "\n",
    "# Створюємо кілька полиць і організовуємо книги по категоріях\n",
    "shelf1 = Shelf()\n",
    "shelf2 = Shelf()\n",
    "\n",
    "# Додаємо книги до полиць\n",
    "for book in books:\n",
    "    if book.category in [\"Fiction\", \"Science\"]:\n",
    "        shelf1.add_book(book)\n",
    "    else:\n",
    "        shelf2.add_book(book)\n",
    "\n",
    "# Сортуємо книги на кожній полиці\n",
    "shelf1.sort_books()\n",
    "shelf2.sort_books()\n",
    "\n",
    "# Додаємо полиці до кімнати\n",
    "room.add_shelf(shelf1)\n",
    "room.add_shelf(shelf2)\n",
    "\n",
    "# Виводимо вміст кімнати\n",
    "print(room)\n"
